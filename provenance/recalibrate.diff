+            rec, dc, stops = results[alpha_name(ef, a)]
+            e = stats(f_rec, f_dc, rec, dc, stops, R)
+            e.update(alpha=a, quality_pass=bool(e['coverage'] >= C and e['mean_loss'] <= LOSS))
