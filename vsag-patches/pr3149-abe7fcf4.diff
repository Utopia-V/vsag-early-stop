+TEST_CASE("Distance early stop tracks requested eligible top-k within the fixed search",
+          "[ut][BasicSearcher][distance_early_stop]") {
+    auto allocator = SafeAllocator::FactoryDefaultAllocator();
+    IndexCommonParam common;
