+            JsonType::Parse(R"({"hgraph":{"ef_search":64,"early_stop":{"type":"distance"}}})");
+        if (alpha > 0.0F) {
+            parsed["hgraph"]["early_stop"]["alpha"].SetFloat(alpha);
