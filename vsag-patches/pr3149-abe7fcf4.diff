+bool
+HGraphSearchParameters::DistanceEarlyStopApplies(uint64_t ef, int64_t k) {
+    return static_cast<double>(ef) > DISTANCE_EARLY_STOP_MIN_EF_TO_K * static_cast<double>(k);
+}
