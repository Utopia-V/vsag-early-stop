+    }
+
+    Filter* attr_ft = nullptr;
+    if (not inner_search_param.executors.empty() and inner_search_param.executors[0] != nullptr) {
+        inner_search_param.executors[0]->Clear();
+        attr_ft = inner_search_param.executors[0]->Run();
+    }
+
+    auto check_func = [&is_id_allowed, &attr_ft](InnerIdType id) {
+        return (is_id_allowed == nullptr or is_id_allowed->CheckValid(id)) and
+               (attr_ft == nullptr or attr_ft->CheckValid(id));
+    };
+
+    if (inner_search_param.enable_rabitq_one_bit_search) {
+        flatten->QueryWithDistanceLowerBound(&dist, nullptr, computer, &ep, 1, ctx);
+    } else {
+        flatten->Query(&dist, computer, &ep, 1, ctx);
+    }
+    if (check_func(ep) and is_result_distance_eligible<mode>(dist, inner_search_param)) {
+        top_candidates->Push(dist, ep);
+        early_stopper.Record(dist);
+    }
+    // See BasicSearcher: the entry point's duplicate labels are only expanded from this seed block.
+    if (inner_search_param.consider_duplicate and
+        is_result_distance_eligible<mode>(dist, inner_search_param)) {
+        for (const auto duplicate_id : graph->GetDuplicateIds(ep)) {
+            if (check_func(duplicate_id)) {
+                top_candidates->Push(dist, duplicate_id);
+                early_stopper.Record(dist);
+            }
+        }
+        if constexpr (mode == KNN_SEARCH) {
+            while (top_candidates->Size() > ef) {
+                top_candidates->Pop();
+            }
+        }
+    }
+    if constexpr (mode == InnerSearchMode::RANGE_SEARCH) {
+        while (dist > inner_search_param.radius and not top_candidates->Empty()) {
+            top_candidates->Pop();
+        }
+    }
+    if (not top_candidates->Empty()) {
+        lower_bound = top_candidates->Top().first;
+    }
+    if (dist < THRESHOLD_ERROR) {
+        inner_search_param.duplicate_id = ep;
+    }
+    candidate_set->Push(traversal_priority(dist), ep);
+    vl->Set(ep);
+
+    auto num_threads = inner_search_param.parallel_search_thread_count - 1;
+
+    using SearchTask = std::tuple<float*, float*, InnerIdType*, uint64_t>;
+    std::vector<SPSCQueue<SearchTask, 1024>> queues(num_threads);
+
+    std::atomic<uint32_t> num_points{0};
+
+    auto task = [&](uint64_t thread_id) {
+        auto worker_computer = flatten->FactoryComputer(query);
+        RecordQueryComputerCreation(ctx == nullptr ? nullptr : ctx->stats);
+        SearchTask item;
+        while (true) {
+            if (queues[thread_id].Pop(item)) {
+                auto [distances, lower_bounds, ids, count] = item;
+                if (distances == nullptr) {
+                    break;
+                }
+                if (inner_search_param.enable_rabitq_one_bit_search) {
+                    flatten->QueryWithDistanceLowerBound(
+                        distances, lower_bounds, worker_computer, ids, count, ctx);
+                } else {
+                    flatten->Query(distances, worker_computer, ids, count, ctx);
+                }
+                num_points.fetch_add(count, std::memory_order_release);
+            } else {
+                CpuRelax();
+            }
+        }
+    };
+
+    std::vector<std::future<void>> futures;
+    futures.reserve(num_threads);
+    for (uint64_t i = 0; i < num_threads; i++) {
+        futures.emplace_back(pool->GeneralEnqueue(task, i));
+    }
+
+    // Neighbors rejected by the filter are deferred rather than dropped: when the queue runs dry
+    // before enough results are found, they are expanded as bridges toward the eligible region.
+    Vector<InnerIdType> deferred_ids(alloc);
+    uint64_t deferred_pos = 0;
+    auto rescue_deferred = [&]() {
+        if constexpr (mode != InnerSearchMode::KNN_SEARCH) {
+            return false;
+        } else {
+            if (top_candidates->Size() >= inner_search_param.min_results ||
+                deferred_pos >= deferred_ids.size()) {
+                return false;
+            }
+            auto count = static_cast<uint32_t>(
+                std::min<uint64_t>(deferred_ids.size() - deferred_pos, to_be_visited_id.size()));
+            for (uint32_t i = 0; i < count; ++i) {
+                to_be_visited_id[i] = deferred_ids[deferred_pos + i];
+            }
+            deferred_pos += count;
+            flatten->Query(line_dists.data(), computer, to_be_visited_id.data(), count, ctx);
+            dist_cmp += count;
+            for (uint32_t i = 0; i < count; ++i) {
+                candidate_set->Push(traversal_priority(line_dists[i]), to_be_visited_id[i]);
+            }
+            return true;
+        }
+    };
+
+    while (true) {
+        if (candidate_set->Empty() and not rescue_deferred()) {
+            break;
+        }
+        hops++;
+        auto num_explore_nodes = candidate_set->Size() < beam ? candidate_set->Size() : beam;
+
+        auto current_first_node_pair = candidate_set->Top();
+        node_pair[0] = current_first_node_pair;
+
+        if constexpr (mode == InnerSearchMode::KNN_SEARCH) {
+            if ((-current_first_node_pair.first) > lower_bound && top_candidates->Size() == ef) {
+                break;
+            }
+        }
+        if constexpr (early_stop) {
+            // Same rule as BasicSearcher, checked against the first node of each popped beam;
+            // only the distance computations run on worker threads.
+            if (early_stopper.ShouldStop(-current_first_node_pair.first)) {
+                if (ctx != nullptr and ctx->stats != nullptr) {
+                    ctx->stats->early_stop_count.fetch_add(1, std::memory_order_relaxed);
+                }
+                if (ctx != nullptr and ctx->reasoning_ctx != nullptr) {
+                    ctx->reasoning_ctx->SetTermination(
+                        ReasoningTermination::kDistanceEarlyStop);  // [reasoning]
+                }
+                break;
+            }
+        }
+        candidate_set->Pop();
+
+        for (uint64_t i = 1; i < num_explore_nodes; i++) {
+            node_pair[i] = candidate_set->Top();
+            candidate_set->Pop();
+        }
+
+        count_no_visited = visit(
+            graph,
+            vl,
+            node_pair,
+            inner_search_param.is_inner_id_allowed,
+            skip_strategy.get(),
+            to_be_visited_id,
+            neighbors,
+            num_explore_nodes,
+            mode == KNN_SEARCH and inner_search_param.min_results > 0 ? &deferred_ids : nullptr);
+
+        bool collect_rabitq_lower_bound = false;
+        if (inner_search_param.enable_rabitq_one_bit_search and top_candidates->Size() == ef and
+            rabitq_lower_bound_candidates != nullptr) {
+            collect_rabitq_lower_bound = true;
+        }
+
+        dist_cmp += count_no_visited;
+        num_points.store(0, std::memory_order_relaxed);
+        const auto task_count = num_threads + 1;
+        auto point_per_thread = count_no_visited / task_count;
+        auto hard_task_count = count_no_visited % task_count;
+
+        uint64_t offset = 0;
+        for (uint64_t i = 0; i < num_threads; ++i) {
+            auto* lower_bounds =
+                collect_rabitq_lower_bound ? lower_bound_dists.data() + offset : nullptr;
+            if (i < hard_task_count) {
+                queues[i].Push({line_dists.data() + offset,
+                                lower_bounds,
+                                to_be_visited_id.data() + offset,
+                                point_per_thread + 1});
+                offset += point_per_thread + 1;
+            } else {
+                queues[i].Push({line_dists.data() + offset,
+                                lower_bounds,
+                                to_be_visited_id.data() + offset,
+                                point_per_thread});
+                offset += point_per_thread;
+            }
+        }
+
+        // Pair with every worker completion release before consuming its distance writes.
+        // A relaxed observation of the count does not publish those buffers on ARM.
+        while (num_points.load(std::memory_order_acquire) < count_no_visited) {
+            if (offset >= count_no_visited) {
+                CpuRelax();
+                continue;
+            }
+            const auto remaining_work = count_no_visited - offset;
+            if (inner_search_param.enable_rabitq_one_bit_search) {
+                auto* lower_bounds =
+                    collect_rabitq_lower_bound ? lower_bound_dists.data() + offset : nullptr;
+                flatten->QueryWithDistanceLowerBound(line_dists.data() + offset,
+                                                     lower_bounds,
+                                                     computer,
+                                                     to_be_visited_id.data() + offset,
+                                                     remaining_work,
+                                                     ctx);
+            } else {
+                flatten->Query(line_dists.data() + offset,
+                               computer,
+                               to_be_visited_id.data() + offset,
+                               remaining_work,
+                               ctx);
+            }
+            num_points.fetch_add(remaining_work, std::memory_order_release);
+            offset += remaining_work;
+        };
+
+        for (uint64_t i = 0; i < count_no_visited; i++) {
+            dist = line_dists[i];
+            const auto cur_id = to_be_visited_id[i];
+            if (not is_finite_distance(dist)) {
+                auto push_result = [&](InnerIdType result_id) {
+                    if (not is_result_distance_eligible<mode>(dist, inner_search_param) or
+                        not check_func(result_id)) {
+                        return;
+                    }
+                    top_candidates->Push(dist, result_id);
+                    if constexpr (mode == KNN_SEARCH) {
+                        while (top_candidates->Size() > ef) {
+                            top_candidates->Pop();
+                        }
+                    } else if (dist > inner_search_param.radius) {
+                        top_candidates->Pop();
+                    }
+                };
+                push_result(cur_id);
+                if (inner_search_param.consider_duplicate) {
+                    for (const auto duplicate_id : graph->GetDuplicateIds(cur_id)) {
+                        push_result(duplicate_id);
+                    }
+                }
+                candidate_set->Push(traversal_priority(dist), cur_id);
+                if (not top_candidates->Empty()) {
+                    lower_bound = top_candidates->Top().first;
+                }
+                continue;
+            }
+            if constexpr (mode == KNN_SEARCH) {
+                if (collect_rabitq_lower_bound and lower_bound_dists[i] < lower_bound and
+                    check_func(cur_id)) {
+                    rabitq_lower_bound_candidates->emplace_back(lower_bound_dists[i], cur_id);
+                }
+            }
+            if (dist < THRESHOLD_ERROR) {
+                inner_search_param.duplicate_id = cur_id;
+            }
+            if (top_candidates->Size() < ef || lower_bound > dist ||
+                (mode == RANGE_SEARCH && dist <= inner_search_param.radius)) {
+                candidate_set->Push(-dist, cur_id);
+                if (check_func(cur_id)) {
+                    top_candidates->Push(dist, cur_id);
+                    early_stopper.Record(dist);
+                }
+                if (inner_search_param.consider_duplicate) {
+                    const auto duplicate_ids = graph->GetDuplicateIds(cur_id);
+                    for (const auto& item : duplicate_ids) {
+                        if (check_func(item)) {
+                            top_candidates->Push(dist, item);
+                            early_stopper.Record(dist);
+                        }
+                    }
+                }
+
+                if constexpr (mode == KNN_SEARCH) {
+                    if (top_candidates->Size() > ef) {
+                        top_candidates->Pop();
+                    }
+                }
+
+                if (not top_candidates->Empty()) {
+                    lower_bound = top_candidates->Top().first;
+                }
+            }
+        }
+    }
+
+    if constexpr (mode == KNN_SEARCH) {
+        while (top_candidates->Size() > inner_search_param.topk) {
+            top_candidates->Pop();
+        }
+    } else if constexpr (mode == RANGE_SEARCH) {
+        if (inner_search_param.range_search_limit_size > 0) {
+            while (top_candidates->Size() > inner_search_param.range_search_limit_size) {
+                top_candidates->Pop();
+            }
+        }
+        while (not top_candidates->Empty() &&
+               top_candidates->Top().first > inner_search_param.radius + THRESHOLD_ERROR) {
+            top_candidates->Pop();
+        }
+    }
+
+    for (uint64_t i = 0; i < num_threads; i++) {
+        queues[i].Push({nullptr, nullptr, nullptr, 0});
+    }
+    for (auto& future : futures) {
+        future.get();
+    }
+
+    if (ctx != nullptr and ctx->stats != nullptr) {
+        ctx->stats->dist_cmp.fetch_add(dist_cmp, std::memory_order_relaxed);
+        ctx->stats->hops.fetch_add(hops, std::memory_order_relaxed);
+    }
+
+    return top_candidates;
+}
+
+}  // namespace vsag
